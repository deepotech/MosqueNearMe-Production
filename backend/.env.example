# ─────────────────────────────────────────────────────────────────────────────
# MosqueNearMe — External Donation Backend Configuration
# Copy this file to .env and fill in real values before starting the server.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL is REQUIRED for production.
# Without DATABASE_URL the server falls back to MemoryDatabase (data lost on restart).
#
# After setting DATABASE_URL, run the schema once:
#   Linux/macOS : npm run db:init
#   Windows     : npm run db:init:win
#
# Schema creates: donations, payouts, webhook_events tables + indexes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ─────────────────────────────────────────────────────────────────────────────
# CORS — comma-separated list of allowed frontend origins
# ─────────────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://mosquenearme.net,http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# PayPal
# ─────────────────────────────────────────────────────────────────────────────
# Mode: sandbox (testing) or live (production)
PAYPAL_MODE=sandbox

# Sandbox credentials — get from developer.paypal.com → My Apps & Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret

# Webhook ID — from PayPal Developer Dashboard → Webhooks
# Required in production for signature verification.
# In sandbox with no webhook ID, signatures are accepted automatically (dev only).
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# ─────────────────────────────────────────────────────────────────────────────
# Admin
# ─────────────────────────────────────────────────────────────────────────────
# Used in: Authorization: Bearer <ADMIN_API_KEY>
# CHANGE THIS before going live. Use a long random string (32+ chars).
ADMIN_API_KEY=change_me_to_a_long_random_secret_in_production

# ─────────────────────────────────────────────────────────────────────────────
# Integration Tests (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Only needed to run: npx tsx src/tests/integration-test-pg.ts
# Use a separate test database — not your production DB.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE
